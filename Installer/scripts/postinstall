#!/bin/bash
# Launch Credo for the logged-in user once installation finishes.
CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]]; then
    CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER")"
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open -a "/Applications/Credo.app" || true
fi
exit 0
